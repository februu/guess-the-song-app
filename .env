# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Token from: Cloudflare Zero Trust → Access → Tunnels → your tunnel → Configure
# Set the tunnel's public hostname to point at: http://caddy:80
CLOUDFLARE_TUNNEL_TOKEN=

# ── Domain (replace with your actual Cloudflare tunnel domain) ───────────────
FRONTEND_URL=https://your-domain.com
SPOTIFY_REDIRECT_URI=https://your-domain.com/callback
DJANGO_ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-domain.com
