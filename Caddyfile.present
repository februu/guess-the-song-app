:80 {
    handle /ws/* {
        reverse_proxy backend:8000
    }
    handle /spotify/* {
        reverse_proxy backend:8000
    }
    handle /callback* {
        reverse_proxy backend:8000
    }
    handle /admin/* {
        reverse_proxy backend:8000
    }
    handle /static/* {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:3000
    }
}
