# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET=

# From https://developer.spotify.com/dashboard — create an app and copy these
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must exactly match the redirect URI registered in your Spotify app settings
SPOTIFY_REDIRECT_URI=http://localhost:8000/callback

# Where the backend redirects the browser after OAuth completes
FRONTEND_URL=http://localhost:3000

# Redis connection URL — used by Django Channels for WebSocket support
REDIS_URL=redis://redis:6379
