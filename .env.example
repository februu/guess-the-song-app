# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET=

# Never set to True in production
DEBUG=False

# Comma-separated. Must include your VPS IP or domain name.
# Example: DJANGO_ALLOWED_HOSTS=203.0.113.10,muzzly.example.com
DJANGO_ALLOWED_HOSTS=your-vps-ip,localhost

# ── Spotify OAuth ─────────────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard and copy these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must exactly match the Redirect URI registered in your Spotify app settings.
# With nginx on port 80: http://your-vps-ip/callback
# With a domain + SSL:   https://yourdomain.com/callback
SPOTIFY_REDIRECT_URI=http://your-vps-ip/callback

# ── Public URLs ───────────────────────────────────────────────────────────────
# The URL users open in their browser (same origin as nginx).
# HTTP:  http://your-vps-ip
# HTTPS: https://yourdomain.com
#
# Setting this to an https:// URL automatically enables SESSION_COOKIE_SECURE.
FRONTEND_URL=http://your-vps-ip

# ── Redis (leave as-is) ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
